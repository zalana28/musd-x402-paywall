# Copy to .env and fill in. The demo key below has no funds — replace for production.
# payTo address (seller) — required
SELLER_ADDRESS=0x2d31C9d84812E009A362C8caE6F3F3e17E5C78b9

# Mezo network
NETWORK=eip155:31611
RPC_URL=https://rpc.test.mezo.org
MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# x402 facilitator
FACILITATOR_URL=https://facilitator.vativ.io

# CORS: "*" for local demo, or comma-separated origins in production
CORS_ORIGIN=*

# Per-IP rate limit (requests / minute)
RATE_LIMIT_MAX=90

PORT=4021

# MEZO holder discount (both tracks) — set to the real MEZO ERC20 on Matsnet when known
#MEZO_ADDRESS=
#MEZO_DISCOUNT_BPS=2000

# Juri / sponsored demo — set true to expose GET /demo/sponsored (happy path without funding)
#DEMO_SPONSOR=false

# MEZO token on Matsnet (found via faucet tx) — enables the holder discount check
MEZO_ADDRESS=0x7b7c000000000000000000000000000000000001

# x402 settlement asset: musd (default) | btc (native-BTC ERC20 mirror)
PAYMENT_ASSET=musd
BTC_ERC20_ADDRESS=0x7b7C000000000000000000000000000000000000
